{
  "name": "visual-comparison-debugging-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Visual-to-code React + TypeScript benchmark challenge: The Misaligned Comparison — Repair an Interactive Before/After Slider",
  "type": "module",
  "workspaces": [
    "starter",
    "reference-solution"
  ],
  "scripts": {
    "dev": "vite",
    "dev:starter": "cross-env CHALLENGE_TARGET=starter vite",
    "dev:reference": "cross-env CHALLENGE_TARGET=reference vite",
    "build": "npm run typecheck && npm run build:starter && npm run build:reference",
    "build:starter": "cross-env CHALLENGE_TARGET=starter vite build --outDir dist/starter",
    "build:reference": "cross-env CHALLENGE_TARGET=reference vite build --outDir dist/reference-solution",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint starter/src reference-solution/src tests",
    "test": "playwright test",
    "test:starter": "cross-env CHALLENGE_TARGET=starter playwright test",
    "test:reference": "cross-env CHALLENGE_TARGET=reference playwright test",
    "capture:references": "node scripts/capture-references.mjs",
    "capture:plates": "node scripts/generate-visual-plates.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^16.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0"
  }
}
